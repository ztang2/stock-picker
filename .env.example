# Required for macro regime detection
FRED_API_KEY=your_fred_api_key_here

# Required for Devil's Advocate tab and AI thesis
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — only needed for live/paper trading via Alpaca
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Internal API auth (can be any string)
API_KEY=stock-picker

# Optional — daily Discord briefing webhook (drives scripts/post_briefing.py)
# Create in Discord: Channel → Edit Channel → Integrations → Webhooks → New
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token
